<?xml version="1.0" encoding="UTF-8"?>
<!--
  MoveIt's extra knowledge about the arm. The arm model has placeholder shapes until the CAD is final,
  so redo the collision list with the MoveIt Setup Assistant then (see docs/appendix/appendix-from-cad.md).
-->
<robot name="sixeyes">
  <group name="arm">
    <chain base_link="base_link" tip_link="tool_link"/>
  </group>
  <group name="gripper">
    <joint name="gripper"/>
  </group>

  <group_state name="home" group="arm">
    <joint name="base" value="0"/>
    <joint name="shoulder" value="0"/>
    <joint name="elbow" value="0"/>
    <joint name="wrist_pitch" value="0"/>
    <joint name="wrist_roll" value="0"/>
  </group_state>
  <group_state name="ready" group="arm">
    <joint name="base" value="0"/>
    <joint name="shoulder" value="0.4"/>
    <joint name="elbow" value="1.3"/>
    <joint name="wrist_pitch" value="-0.6"/>
    <joint name="wrist_roll" value="0"/>
  </group_state>
  <group_state name="open" group="gripper">
    <joint name="gripper" value="0.04"/>
  </group_state>
  <group_state name="closed" group="gripper">
    <joint name="gripper" value="0"/>
  </group_state>

  <end_effector name="hand" parent_link="tool_link" group="gripper" parent_group="arm"/>

  <!-- Neighbouring links always touch at their joint: do not check them against each other. -->
  <disable_collisions link1="base_link" link2="turntable_link" reason="Adjacent"/>
  <disable_collisions link1="turntable_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="upper_arm_link" link2="forearm_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="wrist_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_link" link2="hand_link" reason="Adjacent"/>
  <disable_collisions link1="hand_link" link2="tool_link" reason="Adjacent"/>
  <disable_collisions link1="hand_link" link2="finger_left" reason="Adjacent"/>
  <disable_collisions link1="hand_link" link2="finger_right" reason="Adjacent"/>
  <disable_collisions link1="finger_left" link2="finger_right" reason="Default"/>
  <disable_collisions link1="finger_left" link2="tool_link" reason="Default"/>
  <disable_collisions link1="finger_right" link2="tool_link" reason="Default"/>
  <!-- Links two joints apart that the placeholder shapes cannot reach each other in. -->
  <disable_collisions link1="base_link" link2="upper_arm_link" reason="Never"/>
  <disable_collisions link1="turntable_link" link2="forearm_link" reason="Never"/>
  <disable_collisions link1="upper_arm_link" link2="wrist_link" reason="Never"/>
</robot>
